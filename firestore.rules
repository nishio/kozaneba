rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /ba/{ba} {
      function signed_in() {
        return request.auth != null;
      }
      function old_writers() {
        return resource.data.get("writers", []);
      }
      function new_writers() {
        return request.resource.data.writers;
      }
      function is_writer() {
        return signed_in() && request.auth.uid in old_writers();
      }
      // The first writer is the creator of the ba (initial_save puts the
      // creator there and if_not_in_writer_add_self only appends).
      function is_owner() {
        return signed_in() && old_writers().size() > 0
          && old_writers()[0] == request.auth.uid;
      }
      // Same fields as state_to_docdate
      function valid_shape() {
        return request.resource.data.keys().hasOnly([
            "version", "itemStore", "drawOrder", "last_updated",
            "anyone_writable", "title", "writers", "annotations", "scrapbox"])
          && request.resource.data.writers is list
          && request.resource.data.anyone_writable is bool;
      }
      // writers only grows, and only by the requesting user themself; the
      // existing writers and the owner position (writers[0]) are kept. This
      // holds for the owner too: nobody can put someone else into writers
      // (which would push a ba into their "Ba which you can write" list and
      // could never be undone by them). The ownerless case (writers: [], e.g.
      // made by create_ba) lets the first signed-in editor take writers[0].
      function only_adds_self_to_writers() {
        return new_writers().hasAll(old_writers())
          && new_writers().toSet().difference(old_writers().toSet())
               .hasOnly([request.auth.uid])
          && (new_writers().size() == old_writers().size()
              || (!(request.auth.uid in old_writers())
                  && new_writers().size() == old_writers().size() + 1))
          && (old_writers().size() == 0 || new_writers()[0] == old_writers()[0]);
      }
      function keeps_anyone_writable() {
        return request.resource.data.anyone_writable
            == resource.data.get("anyone_writable", false);
      }

      allow get: if true;
      allow list: if is_writer();
      allow create: if signed_in() && valid_shape()
        && new_writers() == [request.auth.uid];
      // Only the owner may change anyone_writable (and delete).
      allow update: if signed_in() && valid_shape()
        && only_adds_self_to_writers() && (
          is_owner()
          || ((resource.data.get("anyone_writable", false) || is_writer())
              && keeps_anyone_writable()));
      allow delete: if is_owner();
    }
  }
}
